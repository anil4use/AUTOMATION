{
  "name": "automation-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@9.0.0",
  "description": "Enterprise-grade MERN + AI Agent Automation Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/test-runner.ts",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "connectors:seed": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/seed-connectors-v2.ts",
    "connectors:migrate:v2": "npm run connectors:seed",
    "seed:field-catalog": "npm run seed:field-catalog --workspace=@automation/database",
    "seed:coercion-rules": "npm run seed:coercion-rules --workspace=@automation/database",
    "seed:synonym-groups": "npm run seed:synonym-groups --workspace=@automation/database",
    "seed:all": "npm run seed:all --workspace=@automation/database"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
