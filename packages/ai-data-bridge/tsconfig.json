{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@automation/database": ["../database/dist"],
      "@automation/data-mapper": ["../data-mapper/dist"]
    }
  },
  "include": ["src/**/*"]
}
