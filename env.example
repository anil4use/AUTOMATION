# ==============================================================================
# AUTOMATION PLATFORM MASTER ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=32_bytes_hex_string_for_aes256_encryption_key_1234

# MongoDB Atlas Database Configuration (Free Tier M0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/automation_platform?retryWrites=true&w=majority

# Upstash Redis & BullMQ Queue Configuration (Free Tier)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# If using Upstash Redis URL:
# REDIS_URL=rediss://default:password@region.upstash.io:6379

# AI Agent Service (LLM Integration - Free Tiers: Groq / Gemini)
GROQ_API_KEY=gsk_your_free_groq_api_key
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key
DEFAULT_LLM_PROVIDER=groq

# OAuth App Credentials (Dev Mode - Free)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
SLACK_CLIENT_ID=your_slack_oauth_client_id
SLACK_CLIENT_SECRET=your_slack_oauth_client_secret

# Next.js Frontend Configuration (Public)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ==============================================================================
# WHATSAPP AGENT AUTOMATION (Optional — only needed for WA Agent feature)
# ==============================================================================
# These are stored per-automation in the database (encrypted).
# Below are defaults for the Meta API version.

# Meta WhatsApp Business API version (default: v19.0)
WHATSAPP_API_VERSION=v19.0

# Per-Automation credentials are stored encrypted in MongoDB.
# When creating a WhatsApp Automation via the API, provide:
#   - whatsappPhoneNumberId  (from Meta Developer Portal > WhatsApp > Phone Numbers)
#   - accessToken            (System User access token from Meta Business Manager)
#   - verifyToken            (any random string you choose for webhook verification)
#
# Webhook URL format:  https://your-domain.com/api/v1/wa/webhook/<automationId>
# Register this URL in: Meta Developer Portal > WhatsApp > Configuration > Webhooks
# Subscribe to events: messages, messaging_postbacks

