# ============================================================
#  AutoFlow AI Platform — Backend Environment Configuration
#  Copy this to apps/backend/.env and fill in real values
# ============================================================

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- Client (Frontend URL for CORS & OAuth redirects) -----
CLIENT_URL=http://localhost:3000

# ----- MongoDB Atlas -----
# Replace with your real Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/automation_platform?retryWrites=true&w=majority

# ----- JWT Auth -----
# Use a long random string (32+ chars). Never use the default in production!
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ----- AES-256 Token Encryption (must be exactly 32 hex chars = 256 bits) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_HEX_KEY_HERE

# ----- Upstash Redis (BullMQ Worker Queue) -----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password_here   # Uncomment for Upstash/remote Redis

# ----- AI / LLM Providers -----
# At least one provider key is required for AI features to work.

# Groq (free tier, fast inference) — https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# OpenRouter (500+ models incl. free tiers) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENROUTER_SITE_URL=https://yourapp.com
OPENROUTER_SITE_NAME=YourAppName

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Which provider to enable by default on first boot
# Options: openrouter | groq | gemini | openai
DEFAULT_LLM_PROVIDER=openrouter

# ----- Stripe (Billing) -----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ----- Google OAuth (Gmail, Sheets, Drive) -----
# Create at https://console.cloud.google.com/ → OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
